<Window x:Class="ValleyBaptistBulletinEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bulletin Editor" Width="1500" Height="940" MinWidth="1080" MinHeight="720" Background="#EDF2F8">
 <DockPanel LastChildFill="True">
  <!-- Main application workspace: this is the window users see at launch. -->
  <Border DockPanel.Dock="Top" Background="#14263D" Padding="24,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="AppChurchHeader" Text="VALLEY BAPTIST CHURCH" Foreground="#A9C4E3" FontWeight="Bold" FontSize="12"/>
     <TextBlock Text="Bulletin Studio" Foreground="White" FontWeight="SemiBold" FontSize="29" Margin="0,3,0,0"/>
     <TextBlock Text="Weekly worship publishing  /  Four-panel folded bulletin" Foreground="#BDCBDD" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="New Bulletin" Click="New_Click" Style="{StaticResource HeaderActionButton}"/>
     <Button Content="Open" Click="Open_Click" Style="{StaticResource HeaderActionButton}"/>
     <Button Content="Save As" Click="Save_Click" Style="{StaticResource HeaderActionButton}"/>
     <Button Content="Print / PDF" Click="Print_Click" Style="{StaticResource HeaderPrimaryButton}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DEE5EE" BorderThickness="0,0,0,1" Padding="16,10">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
     <Button Content="✎  Edit Bulletin Pages" Click="PublisherEdit_Click" Style="{StaticResource WorkspaceActionButton}"/>
     <Button Content="◫  Print Preview" Click="Preview_Click" Style="{StaticResource WorkspaceActionButton}"/>
     <Button Content="◷  Bulletin History" Click="History_Click" Style="{StaticResource WorkspaceActionButton}"/>
    </StackPanel>
    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="⚙  Publisher / Layout Settings" Click="Settings_Click" Style="{StaticResource WorkspaceActionButton}"/>
   </DockPanel>
  </Border>
  <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="395"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="14" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="CONTENT WORKSPACE" Foreground="#597A9D" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Weekly Bulletin" Foreground="#192D46" FontWeight="SemiBold" FontSize="24" Margin="0,5,0,0"/>
      <TextBlock Text="Edit text and service information here. Open the page designer for text boxes, images and precise positioning." TextWrapping="Wrap" Foreground="#65758A" FontSize="12" Margin="0,7,0,0"/>
     </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Weekly bulletin information is below. It is preserved and editable. Pages 2–4 use the church's original bulletin layout. Edit the weekly fields below to update the printed layout live. Editing Page Heading or Page Text directly switches that page to custom mode; use Restore to return to the original layout." TextWrapping="Wrap" Foreground="#3B566F" Margin="0,0,0,8"/>
     <Button Content="Restore original church layout on pages 2–4" Click="FillPages_Click" Margin="0,0,0,10"/>
     <TextBlock Text="Folded bulletin panel" FontWeight="Bold" Margin="0,0,0,5"/>
     <ComboBox x:Name="PanelSelector" Height="36" SelectionChanged="PanelSelector_SelectionChanged" Margin="0,0,0,9"/>
     <TextBlock x:Name="PanelStatus" Foreground="#4B5D70" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <StackPanel x:Name="PanelEditor" Margin="0,0,0,16">
      <TextBlock Text="Page heading" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PanelTitle" TextChanged="PanelText_Changed"/>
      <TextBlock Text="Page text" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PanelBody" Height="240" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="PanelText_Changed"/>
      <TextBlock Text="Page alignment" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PanelAlignment" Height="32" SelectionChanged="PanelText_Changed"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Right"/></ComboBox>
      <CheckBox x:Name="PanelEnabled" Content="Include this panel in printing" Margin="0,12,0,5" Checked="PanelText_Changed" Unchecked="PanelText_Changed"/>
      <CheckBox x:Name="PanelBlank" Content="Intentionally blank panel" Margin="0,0,0,12" Checked="PanelText_Changed" Unchecked="PanelText_Changed"/>
      <WrapPanel Margin="0,0,0,8"><Button Content="Add / Change Picture" Click="AddPicture_Click"/><Button Content="Remove Picture" Click="RemovePicture_Click"/></WrapPanel>
      <TextBlock x:Name="PictureStatus" TextWrapping="Wrap" Foreground="#4B5D70"/>
     </StackPanel>
     <Expander Header="Weekly Information — Church, Worship, Announcements &amp; Calendar" IsExpanded="True" Margin="0,0,0,12"><StackPanel>
     <Expander Header="Church &amp; Service" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="8"><TextBlock Text="Bulletin date" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Date,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Welcome scripture" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Verse,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Pastor" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Pastor,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Welcome / Prayer" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Welcome,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Sermon title" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Sermon,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Sermon scripture" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Scripture,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Hymns and numbers (one per line)" Style="{StaticResource FieldLabel}"/><TextBox Height="145" AcceptsReturn="True" Text="{Binding Hymns,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Expander>
     <Expander Header="Ministries &amp; People" Margin="0,0,0,12"><StackPanel Margin="8"><TextBlock Text="Secretary" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Secretary,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Church staff and ministries" Style="{StaticResource FieldLabel}"/><TextBox Height="160" AcceptsReturn="True" Text="{Binding Staff,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Expander>
     <Expander Header="Weekly Reports &amp; Schedule" Margin="0,0,0,12"><StackPanel Margin="8"><TextBlock Text="Offering" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offering,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Attendance" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Attendance,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Service schedule" Style="{StaticResource FieldLabel}"/><TextBox Height="150" AcceptsReturn="True" Text="{Binding Schedule,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Expander>
     <Expander Header="Announcements &amp; Calendar" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="8"><TextBlock Text="Announcements" Style="{StaticResource FieldLabel}"/><TextBox Height="180" AcceptsReturn="True" Text="{Binding Announcements,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Monthly calendar" Style="{StaticResource FieldLabel}"/><TextBox Height="155" AcceptsReturn="True" Text="{Binding Calendar,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Closing message" Style="{StaticResource FieldLabel}"/><TextBox Height="90" AcceptsReturn="True" Text="{Binding Footer,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Expander>
    </StackPanel></Expander></StackPanel></ScrollViewer>
   </DockPanel></Border>
   <Border Grid.Column="2" Background="#E1E8F1" BorderBrush="#D1DCE9" BorderThickness="1" CornerRadius="14" Padding="18">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Print Preview" Foreground="#192D46" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="Live print arrangement  •  Outside: back + cover  •  Inside: pages 2 + 3" Foreground="#566477" TextWrapping="Wrap"/>
     </StackPanel>
     <DocumentViewer x:Name="LiveDocumentViewer" Background="#DDE3EA"/>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>
