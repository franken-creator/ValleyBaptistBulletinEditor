<Window x:Class="ValleyBaptistBulletinEditor.DesignStudioWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Publisher / Admin — Page Setup" Width="780" Height="800" MinWidth="600" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F3F5F8">
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <TextBlock Text="Page Setup — Paper and Printing" FontSize="25" FontWeight="Bold" Foreground="#243956"/>
   <TextBlock Text="Configure physical paper, folded pages, margins, cover and printing." Foreground="#586474" Margin="0,5,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
   <TextBlock Text="Page Setup changes require Publisher/Admin permission. Text formatting stays in the Design Inspector." TextWrapping="Wrap" Foreground="#9C4B26" Margin="0,0,0,12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Restore Defaults" Click="Defaults_Click"/>
    <Button Content="Cancel" Click="Cancel_Click"/>
    <Button Content="Save Page Setup" Click="Save_Click" Background="#243956" Foreground="White"/>
   </StackPanel>
  </StackPanel>
  <Border Background="White" CornerRadius="12" Padding="22">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="1. Professional design presets" FontWeight="Bold" FontSize="17"/>
    <ComboBox x:Name="TemplatePicker" SelectionChanged="Preset_Changed" Margin="0,8,0,8" Height="36">
      <ComboBoxItem Content="Valley Baptist Original"/><ComboBoxItem Content="Classic Elegance"/><ComboBoxItem Content="Modern Minimalist"/><ComboBoxItem Content="Botanical Traditional"/><ComboBoxItem Content="Contemporary Newsletter"/>
    </ComboBox>
    <TextBlock Text="Choose a preset to set coordinated colors and fonts. You can fine-tune them below." Foreground="#586474" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <TextBlock Text="2. Page format — physical folded sheet" FontWeight="Bold" FontSize="17"/>
    <ComboBox x:Name="PagePicker" SelectionChanged="Format_Changed" Margin="0,8,0,8" Height="36">
      <ComboBoxItem Content="Four-panel half-fold"/><ComboBoxItem Content="Single-panel sheets"/>
    </ComboBox>
    <TextBlock Text="Half-fold: one sheet prints four logical pages, outside [4 | 1] and inside [2 | 3]. Single-panel: one logical page per printed sheet face. Sheet dimensions are configured below." TextWrapping="Wrap" Foreground="#586474" Margin="0,0,0,18"/>
    <TextBlock Text="3. Pages visible in preview and print" FontWeight="Bold" FontSize="17"/>
    <TextBlock Text="Select which numbered pages can contain content. Unchecked pages stay blank in both live preview and printing. The preprinted cover lock overrides Page 1." TextWrapping="Wrap" Foreground="#586474" Margin="0,7,0,8"/>
    <WrapPanel x:Name="VisiblePagesPanel" Margin="0,0,0,14"/>
    <!-- Legacy design fields are retained for backward-compatible settings loading,
         but typography and text alignment belong to the Design Inspector. -->
    <StackPanel Visibility="Collapsed">
    <TextBlock Text="4. Fine-tune appearance" FontWeight="Bold" FontSize="17" Margin="0,0,0,12"/>
    <TextBlock Text="Color theme" FontWeight="Bold" FontSize="17"/>
    <ComboBox x:Name="ThemePicker" SelectionChanged="Choice_Changed" Margin="0,8,0,20" Height="36">
     <ComboBoxItem Content="Classic Navy"/><ComboBoxItem Content="Sage &amp; Cream"/><ComboBoxItem Content="Black &amp; White"/><ComboBoxItem Content="Burgundy &amp; Gold"/>
    </ComboBox>
    <TextBlock Text="Heading font" FontWeight="Bold" FontSize="17"/>
    <ComboBox x:Name="FontPicker" SelectionChanged="Choice_Changed" Margin="0,8,0,20" Height="36">
     <ComboBoxItem Content="Georgia"/><ComboBoxItem Content="Cambria"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Times New Roman"/>
    </ComboBox>
    <TextBlock Text="Church title size" FontWeight="Bold" FontSize="17"/>
    <Slider x:Name="SizePicker" Minimum="18" Maximum="38" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Choice_Changed" Margin="0,8,0,20"/>

    <Separator Margin="0,14,0,14"/>
    <TextBlock Text="5. Section alignment and typography" FontWeight="Bold" FontSize="18"/>
    <TextBlock Text="Set one alignment for everything or customize each section independently. These settings affect printed pages and print preview." TextWrapping="Wrap" Foreground="#586474" Margin="0,6,0,12"/>
    <TextBlock Text="Entire bulletin alignment" FontWeight="SemiBold"/>
    <ComboBox x:Name="GlobalAlignBox" Height="34" Margin="0,4,0,12">
      <ComboBoxItem Content="Per section"/><ComboBoxItem Content="Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Right"/>
    </ComboBox>
    <UniformGrid Columns="2">
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Church title"/><ComboBox x:Name="TitleAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Order of worship"/><ComboBox x:Name="WorshipAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Sermon"/><ComboBox x:Name="SermonAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Leadership"/><ComboBox x:Name="LeadershipAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Weekly report"/><ComboBox x:Name="ReportsAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Service times"/><ComboBox x:Name="ScheduleAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Announcements"/><ComboBox x:Name="AnnouncementsAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Calendar"/><ComboBox x:Name="CalendarAlignBox" Height="32"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Footer and contact"/><ComboBox x:Name="FooterAlignBox" Height="32"/></StackPanel>
    </UniformGrid>
    <Button Content="Reset section alignment to defaults" Click="ResetSectionAlignment_Click" HorizontalAlignment="Left" Margin="0,2,0,12"/>
    <TextBlock Text="Body text size (points)" FontWeight="SemiBold"/>
    <TextBox x:Name="BodySizeBox" Width="95" HorizontalAlignment="Left" Margin="0,4,0,10"/>
    <TextBlock Text="Spacing between text blocks (points)" FontWeight="SemiBold"/>
    <TextBox x:Name="SectionSpacingBox" Width="95" HorizontalAlignment="Left" Margin="0,4,0,10"/>
    <TextBlock Text="Gap between columns (points)" FontWeight="SemiBold"/>
    <TextBox x:Name="ColumnGapBox" Width="95" HorizontalAlignment="Left" Margin="0,4,0,10"/>
    <Separator Margin="0,14,0,14"/>
    </StackPanel>
    <TextBlock Text="6. Paper Setup — preprinted bulletin stock" FontWeight="Bold" FontSize="17"/>
    <TextBlock Text="Save named paper setups for different purchased bulletin sheets. Dimensions are physical sheet size." TextWrapping="Wrap" Foreground="#586474" Margin="0,6,0,10"/>
    <TextBlock Text="Paper preset name" FontWeight="SemiBold"/><TextBox x:Name="PresetNameBox" Margin="0,4,0,8"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
     <Button Content="Save Named Preset" Click="SavePreset_Click"/><Button Content="Load Named Preset" Click="LoadPreset_Click"/><Button Content="Delete Named Preset" Click="DeletePreset_Click"/>
    </StackPanel>
    <TextBlock Text="Physical sheet dimensions (inches)" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,8">
     <TextBlock Text="Width" VerticalAlignment="Center"/><TextBox x:Name="WidthBox" Width="80" Margin="8,0,18,0"/>
     <TextBlock Text="Height" VerticalAlignment="Center"/><TextBox x:Name="HeightBox" Width="80" Margin="8,0,18,0"/>
     <Button Content="11 × 8.5" Click="LetterLandscape_Click"/><Button Content="8.5 × 11" Click="LetterPortrait_Click"/>
    </StackPanel>
    <TextBlock Text="Logical bulletin pages/panels (1–12, including Page 3)" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ComboBox x:Name="SidesBox" SelectionChanged="PageCount_Changed" Width="100" HorizontalAlignment="Left" Margin="0,5,0,10">
      <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
    </ComboBox>
    <CheckBox x:Name="LockCoverCheck" Content="Page 1 is a preprinted cover — lock and leave blank when printing" Margin="0,2,0,6"/>
    <TextBlock Text="When cover is locked, choose how Page 1 appears in the live bulletin preview. The preprinted cover never receives ink." TextWrapping="Wrap" Foreground="#586474" Margin="0,0,0,8"/>
    <TextBlock Text="Locked cover — live preview display" FontWeight="SemiBold"/>
    <ComboBox x:Name="CoverModeBox" Height="34" Margin="0,4,0,8">
      <ComboBoxItem Content="Blank page"/><ComboBoxItem Content="Hide page in preview"/><ComboBoxItem Content="Show cover picture"/>
    </ComboBox>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Choose cover picture" Click="ChooseCoverPicture_Click"/>
      <Button Content="Remove cover picture" Click="RemoveCoverPicture_Click"/>
    </StackPanel>
    <TextBlock x:Name="CoverPictureStatus" Text="No cover picture selected" TextWrapping="Wrap" Foreground="#586474" Margin="0,0,0,12"/>
    <TextBlock Text="Two-sided printing" FontWeight="SemiBold"/>
    <ComboBox x:Name="DuplexBox" Margin="0,5,0,10" Height="34">
      <ComboBoxItem Content="Long-edge (book)"/><ComboBoxItem Content="Short-edge (flip)"/><ComboBoxItem Content="One-sided"/>
    </ComboBox>
    <TextBlock Text="Half-fold places four logical panels on one sheet, two on each face. Odd or incomplete sets leave unused panel positions blank. Duplex settings apply to physical sheet faces." TextWrapping="Wrap" Foreground="#586474" Margin="0,0,0,12"/>
    <CheckBox x:Name="PreprintedCheck" Content="Preprinted paper: print text only (no decorative design background)" Margin="0,0,0,12"/>
    <TextBlock Text="Safe margin (inches)" FontWeight="SemiBold"/><TextBox x:Name="MarginBox" Width="100" HorizontalAlignment="Left" Margin="0,4,0,12"/>
    <TextBlock Text="Print alignment calibration (inches, positive moves right/down)" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,8">
     <TextBlock Text="Horizontal" VerticalAlignment="Center"/><TextBox x:Name="OffsetXBox" Width="90" Margin="8,0,18,0"/>
     <TextBlock Text="Vertical" VerticalAlignment="Center"/><TextBox x:Name="OffsetYBox" Width="90" Margin="8,0,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button Content="Reset Alignment" Click="ResetAlignment_Click"/><Button Content="Check Printer Compatibility" Click="CheckPrinter_Click"/></StackPanel>
    <TextBlock Text="Printer support is driver-dependent. Always test alignment on plain paper first. Each numbered page has independent content in the main editor." TextWrapping="Wrap" Foreground="#9C4B26" Margin="0,0,0,14"/>
    <TextBlock Text="Design preview" FontWeight="Bold" FontSize="17" Margin="0,0,0,8"/>
    <Border BorderBrush="#CBD3DE" BorderThickness="1" Padding="20" Background="#FCFCFC">
     <StackPanel>
      <TextBlock Text="WELCOME TO" TextAlignment="Center" FontSize="11"/>
      <TextBlock Text="Valley Baptist Church" TextAlignment="Center" FontFamily="{DynamicResource BulletinHeadingFont}" FontSize="{DynamicResource BulletinTitleSize}" Foreground="{DynamicResource BulletinAccentBrush}" FontWeight="Bold"/>
      <TextBlock Text="Sunday Worship • John 3:16" TextAlignment="Center" Margin="0,6,0,12"/>
      <Separator/><TextBlock Text="ORDER OF WORSHIP" FontWeight="Bold" Foreground="{DynamicResource BulletinAccentBrush}" Margin="0,12,0,0"/>
      <TextBlock Text="Welcome / Prayer   •   Hymns   •   Sermon" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel></ScrollViewer>
  </Border>
 </DockPanel>
</Window>
