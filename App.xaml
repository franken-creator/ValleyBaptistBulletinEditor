<Application x:Class="ValleyBaptistBulletinEditor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Application.Resources>
    <SolidColorBrush x:Key="BulletinAccentBrush" Color="#243956"/>
    <FontFamily x:Key="BulletinHeadingFont">Georgia</FontFamily>
    <sys:Double x:Key="BulletinTitleSize">26</sys:Double>
    <SolidColorBrush x:Key="Navy" Color="#243956"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3,0,12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="TextBlock" x:Key="FieldLabel"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#243956"/></Style>
    <Style x:Key="HeaderActionButton" TargetType="Button">
   <Setter Property="Background" Value="#29415D"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#47617F"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="4,0"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="HeaderPrimaryButton" TargetType="Button" BasedOn="{StaticResource HeaderActionButton}">
   <Setter Property="Background" Value="#2B7893"/><Setter Property="BorderBrush" Value="#2B7893"/>
  </Style>
  <Style x:Key="WorkspaceActionButton" TargetType="Button">
   <Setter Property="Background" Value="#F3F7FC"/><Setter Property="Foreground" Value="#233C58"/>
   <Setter Property="BorderBrush" Value="#D5E1EE"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3,0"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
</Application.Resources>
</Application>
